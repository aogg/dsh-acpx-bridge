{
  "name": "dsh-acpx-bridge",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: an acpx_delegate tool that lets the model drive other coding agents via acpx (ACP).",
  "type": "module",
  "license": "MIT",
  "keywords": ["dsh", "deepseek-harness", "acpx", "acp", "subagent", "dsh-plugin"],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/index.js"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.0 <1.0.0",
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "dsh": {
    "entry": "src/index.js",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "selftest": "node src/selftest.mjs"
  }
}
